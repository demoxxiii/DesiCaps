{
  "fonts": [
    "Poppins-Black", "Poppins-ExtraBold", "Poppins-Bold", "Anton-Regular",
    "BebasNeue-Regular", "LuckiestGuy-Regular", "Bangers-Regular",
    "ArchivoBlack-Regular", "Mukta-ExtraBold"
  ],
  "base": {
    "font": "Poppins-Black",
    "size": 78,
    "uppercase": true,
    "lineHeight": 1.12,
    "maxWidth": 0.82,
    "posY": 0.70,
    "textColor": "#FFFFFF",
    "activeColor": "#FFE500",
    "emph1": "#22E06B",
    "emph2": "#FF3D5A",
    "strokeColor": "#000000",
    "stroke": 9,
    "shadowColor": "#000000",
    "shadowOpacity": 0.55,
    "shadowBlur": 10,
    "shadowY": 6,
    "highlight": "color",
    "boxColor": "#7C3AED",
    "boxTextColor": "#FFFFFF",
    "boxRadius": 18,
    "boxPad": 14,
    "pageBg": false,
    "pageBgColor": "#000000",
    "pageBgOpacity": 0.55,
    "mode": "page",
    "dimOpacity": 0.35,
    "pageAnim": "pop",
    "wordAnim": "pop",
    "activeScale": 1.12,
    "wordsPerPage": 3,
    "maxChars": 18,
    "emoji": true,
    "stripPunct": true
  },
  "presets": [
    {"id": "hormozi", "name": "Hormozi Yellow",
     "style": {"font": "Anton-Regular", "size": 96, "activeColor": "#FFE500", "stroke": 10, "highlight": "color", "wordsPerPage": 3}},
    {"id": "beast", "name": "Beast Box",
     "style": {"font": "Poppins-Black", "size": 76, "highlight": "box", "boxColor": "#22C55E", "boxTextColor": "#FFFFFF", "stroke": 7, "wordsPerPage": 3, "activeScale": 1.08}},
    {"id": "desi", "name": "Desi Kesari",
     "style": {"font": "Poppins-ExtraBold", "size": 80, "activeColor": "#FF9933", "emph1": "#22E06B", "emph2": "#FFFFFF", "stroke": 8, "highlight": "color", "uppercase": false, "wordsPerPage": 4, "maxChars": 22}},
    {"id": "karaoke", "name": "Karaoke Reveal",
     "style": {"font": "LuckiestGuy-Regular", "size": 84, "mode": "reveal", "activeColor": "#3DDCFF", "stroke": 9, "wordsPerPage": 5, "maxChars": 26, "pageAnim": "none"}},
    {"id": "punch", "name": "One Word Punch",
     "style": {"font": "Bangers-Regular", "size": 150, "mode": "single", "wordsPerPage": 1, "activeColor": "#FFFFFF", "stroke": 12, "pageAnim": "bounce", "wordAnim": "none", "posY": 0.55, "emph1": "#FFE500", "emph2": "#FF3D5A"}},
    {"id": "minimal", "name": "Clean Minimal",
     "style": {"font": "Poppins-Bold", "size": 58, "uppercase": false, "stroke": 0, "shadowOpacity": 0, "highlight": "none", "pageBg": true, "pageBgOpacity": 0.6, "pageAnim": "fade", "wordAnim": "none", "wordsPerPage": 6, "maxChars": 34, "posY": 0.78}},
    {"id": "neon", "name": "Neon Glow",
     "style": {"font": "ArchivoBlack-Regular", "size": 74, "activeColor": "#00F0FF", "textColor": "#FFFFFF", "stroke": 0, "shadowColor": "#00E5FF", "shadowOpacity": 0.9, "shadowBlur": 18, "shadowY": 0, "highlight": "color", "pageAnim": "slide"}},
    {"id": "bebas", "name": "Bebas Stack",
     "style": {"font": "BebasNeue-Regular", "size": 120, "activeColor": "#FF3D5A", "stroke": 0, "shadowOpacity": 0.7, "shadowBlur": 0, "shadowY": 8, "wordsPerPage": 2, "maxChars": 14, "lineHeight": 0.95}},
    {"id": "devanagari", "name": "Devanagari Bold",
     "style": {"font": "Mukta-ExtraBold", "size": 86, "uppercase": false, "activeColor": "#FFB020", "stroke": 9, "wordsPerPage": 3}}
  ]
}
